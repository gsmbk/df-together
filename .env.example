EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional: a universal web landing URL used in friend-share messages.
EXPO_PUBLIC_APP_SHARE_URL=https://df-together.com/invite
# Optional: the exact HTTPS callback allowed to hand a magic-link session into the app.
EXPO_PUBLIC_AUTH_REDIRECT_URL=https://df-together.com/auth/callback

# Server-side only. Used by the Supabase CLI when pushing Auth SMTP settings.
# Never prefix this variable with EXPO_PUBLIC_ or commit its real value.
RESEND_API_KEY=
